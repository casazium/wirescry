{
  "name": "wirescry",
  "productName": "Wirescry",
  "version": "0.1.23",
  "description": "Desktop tool for seeing, debugging and rewriting HTTP traffic",
  "private": true,
  "author": "casazium",
  "license": "AGPL-3.0-only",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-mockttp.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/third-party-notices.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test-ui.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "node scripts/test-electron.mjs",
    "smoke": "vitest run --config vitest.smoke.config.mts",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "typecheck:pro": "node scripts/typecheck-pro.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "electron-updater": "^6.8.9",
    "http-encoding": "^2.2.0",
    "js-beautify": "^2.0.3",
    "mockttp": "^4.6.4",
    "ws": "^8.22.0",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@casazium/license-sdk": "^0.5.0",
    "@electron/get": "^5.1.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "tls-impersonate": false,
    "electron-winstaller": false,
    "fsevents": false
  }
}
