{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",

    "src/main/**/*",
    "src/preload/**/*",
    "src/backend/**/*",
    "src/shared/**/*",
    "test/**/*"
  ],
  // The component tests are checked with the window's code (tsconfig.test-ui.json).
  "exclude": ["test/ui/**/*"]
}
